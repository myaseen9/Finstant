generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model app_user {
  id              Int            @id @default(autoincrement())
  username        String         @unique
  password_hash   String
  first_name      String
  last_name       String
  role            String         @default("user")
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  designation     String         @default("User")
  is_active       Boolean        @default(true)
  profile_picture String?
  audit_log       audit_log[]
  chat_sessions   chat_session[]
  sessions        sessions[]
}

model chat_session {
  id              String         @id @default(uuid())
  user_id         Int
  title           String?
  created_at      DateTime?      @default(now()) @db.Timestamp(6)
  deleted_by_user Boolean?       @default(false)
  messages        chat_message[]
  user            app_user       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_session_user")

  @@index([user_id], map: "idx_chat_session_user_id")
}

model chat_message {
  id         String       @id @default(uuid())
  session_id String
  role       String
  content    String?
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  session    chat_session @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_message_session")

  @@index([session_id], map: "idx_chat_message_session_id")
}

model file_upload {
  id         Int      @id @default(autoincrement())
  filename   String
  file_hash  String?
  size_bytes Int
  status     String   @default("Ingesting")
  created_at DateTime @default(now()) @db.Timestamp(6)
}

model audit_log {
  id         Int       @id @default(autoincrement())
  user_id    Int
  query_text String?
  parameters String?
  step       Int?
  timestamp  DateTime? @default(now()) @db.Timestamp(6)
  app_user   app_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_audit_log_user")

  @@index([user_id], map: "idx_audit_log_user_id")
}

model sessions {
  id         String    @id
  user_id    Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  expires_at DateTime? @db.Timestamp(6)
  app_user   app_user  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sessions_user")

  @@index([user_id], map: "idx_sessions_user_id")
}
